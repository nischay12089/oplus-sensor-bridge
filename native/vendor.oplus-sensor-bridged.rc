# oplus-sensor-bridged: feeds sensors.oplusbridge.so (first entry in /vendor/etc/sensors/hals.conf)
# with pickup/AMD events, keeps the AOD lit (panel doze brightness, when ro.sys.nischay.bomb=1),
# and serves vendor.oplus.hardware.displaypanelfeature so SystemUI allows full-screen AOD all day.
# class hal: the panel service must be registered before SystemUI starts and reads it.
# Labeled hal_sensors_default_exec, so init runs it in the sensors HAL domain.
service vendor.oplus-sensor-bridged /vendor/bin/hw/oplus-sensor-bridged
    class hal
    user system
    group system wakelock graphics
    capabilities BLOCK_SUSPEND
    task_profiles ServiceCapacityLow

# The same binary, one-shot: applies the AOD defaults after the first boot of a fresh flash, once
# setup has finished (no-op afterwards). uid shell: `cmd settings put` only accepts shell or root.
service vendor.oplus-aod-defaults /vendor/bin/hw/oplus-sensor-bridged --aod-defaults
    user shell
    group shell
    oneshot
    disabled

on property:sys.boot_completed=1 && property:persist.sys.device_provisioned=1
    start vendor.oplus-aod-defaults

# The daemon's sensor queue is a connection to sensorservice in system_server and dies with it,
# silently (pickup and AMD stop). system_server dying always restarts zygote: restart the daemon
# too, like init.zygote64.rc does for audioserver, netd, ... It retries until sensorservice is up.
on property:init.svc.zygote=restarting
    restart vendor.oplus-sensor-bridged

# Screen-off power. Xiaomi's citsensorservice (factory test) keeps the tsl2522 raw ALS (50 ms) and the
# wake-up collision detector (5 ms) on at all times, so the sensor DSP never sleeps with the screen
# off. Run it only while the screen is on (debug.tracing.screen_state: 2 on, 1 off, 3/4 doze). Its rc
# is on /odm: init resolves service names when an action runs, not when this file is parsed.
on property:debug.tracing.screen_state=1
    stop citsensorservice

on property:debug.tracing.screen_state=3
    stop citsensorservice

on property:debug.tracing.screen_state=4
    stop citsensorservice

on property:debug.tracing.screen_state=2
    start citsensorservice

# Xiaomi trusted UI waits for vendor.qti.hardware.systemhelperaidl.ISystemTUICallback, which this
# system never registers, retrying every second forever. Its /odm rc starts it on boot_completed,
# after any trigger of ours on that property (odm is parsed after vendor), so stop it once running.
on property:init.svc.vendor.mitrustedui=running
    stop vendor.mitrustedui
